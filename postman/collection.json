{
  "info": {
    "name": "ACS - Fase 2 API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Test Saludo API",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/saludo",
          "host": ["{{baseUrl}}"],
          "path": ["api", "saludo"]
        }
      }
    },
    {
      "name": "Test Items Inventario",
      "event": [
